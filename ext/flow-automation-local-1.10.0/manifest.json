{
  "manifest_version": 3,
  "name": "Flow Automation Local",
  "version": "1.10.0",
  "description": "Bulk prompt automation cục bộ cho Google Flow: tự báo khi có bản mới, tự chẩn đoán khi Flow đổi giao diện + tự chọn lại selector, chạy nhiều tab song song, prompt không giới hạn ký tự, nhập/xuất .txt, đặt tên theo số thứ tự, thư mục lưu riêng, tạo video từ folder ảnh.",
  "action": {
    "default_title": "Open Flow Automation Local"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "scripting",
    "sidePanel",
    "nativeMessaging",
    "notifications"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://*.flow.google.com/*",
    "https://labs.google/fx/*",
    "https://labs.google.com/fx/*",
    "https://raw.githubusercontent.com/*",
    "https://gist.githubusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://*.flow.google.com/*",
        "https://labs.google/fx/*",
        "https://labs.google.com/fx/*"
      ],
      "js": [
        "content-v2.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}